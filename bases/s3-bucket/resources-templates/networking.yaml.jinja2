---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: {{ nom_club }}-s3-endpoint
  labels:
    kubernetes.io/service-name: {{ nom_club }}-s3-svc
addressType: IPv4
ports:
  - name: http
    protocol: TCP
    port: 7480
endpoints:
  - addresses:
      - 10.0.21.59
    conditions:
      ready: true
---
apiVersion: projectcontour.io/v1
kind: HTTPProxy
metadata:
  name: {{ nom_club }}-s3-httpproxy
spec:
  virtualhost:
    fqdn: s3.{{ nom_club }}.etsmtl.club
    tls:
      secretName: s3-tls
      minimumProtocolVersion: "1.3"
    corsPolicy:
      allowOrigin:
        - {{ domaine }}
      allowMethods:
        - "*"
      allowHeaders:
        - "*"
  routes:
    - conditions:
        - prefix: /
      services:
        - name: {{ nom_club }}-s3-svc
          port: 7480
      timeoutPolicy:
        idle: 600s
        response: 600s
