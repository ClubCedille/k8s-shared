apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ nom_club }}-outlinewiki-tls
spec:
  secretName: {{ nom_club }}-outlinewiki-tls
  issuerRef:
    name: letsencrypt-etsmtl
    kind: ClusterIssuer
  commonName: wiki.{{ nom_club }}.etsmtl.club
  dnsNames:
    - wiki.{{ nom_club }}.etsmtl.club
---
apiVersion: projectcontour.io/v1
kind: HTTPProxy
metadata:
  name: {{ nom_club }}-outlinewiki-httpproxy
spec:
  virtualhost:
    fqdn: wiki.{{ nom_club }}.etsmtl.club
    tls:
      secretName: {{ nom_club }}-outlinewiki-tls
      minimumProtocolVersion: "1.3"
  routes:
    - conditions:
        - prefix: /
      enableWebsockets: true
      services:
        - name: {{ nom_club }}-outlinewiki-svc
          port: 3000
      timeoutPolicy:
        idle: 600s
        response: 600s
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ nom_club }}-outlinewiki-s3-tls
spec:
  secretName: {{ nom_club }}-outlinewiki-s3-tls
  issuerRef:
    name: letsencrypt-etsmtl
    kind: ClusterIssuer
  commonName: s3.{{ nom_club }}.etsmtl.club
  dnsNames:
    - s3.{{ nom_club }}.etsmtl.club
---
apiVersion: v1
kind: Service
metadata:
  name: {{ nom_club }}-outlinewiki-s3
spec:
  ports:
    - name: http
      port: 7480
      targetPort: 7480
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: {{ nom_club }}-outlinewiki-s3
  labels:
    kubernetes.io/service-name: {{ nom_club }}-outlinewiki-s3
addressType: IPv4
ports:
  - name: http
    protocol: TCP
    port: 7480
endpoints:
  - addresses:
      - 10.0.21.59
    conditions:
      ready: true
---
apiVersion: projectcontour.io/v1
kind: HTTPProxy
metadata:
  name: {{ nom_club }}-outlinewiki-s3-httpproxy
spec:
  virtualhost:
    fqdn: s3.{{ nom_club }}.etsmtl.club
    tls:
      secretName: {{ nom_club }}-outlinewiki-s3-tls
      minimumProtocolVersion: "1.3"
    corsPolicy:
      allowOrigin:
        - https://wiki.{{ nom_club }}.etsmtl.club
      allowMethods:
        - "*"
      allowHeaders:
        - "*"
  routes:
    - conditions:
        - prefix: /
      services:
        - name: {{ nom_club }}-outlinewiki-s3
          port: 7480
      timeoutPolicy:
        idle: 600s
        response: 600s
